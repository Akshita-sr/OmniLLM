# === Cloud API Keys ===
# OpenAI (GPT-4o, o1)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google AI (Gemini 2.0 Pro, Gemini 1.5 Flash)
GOOGLE_API_KEY=your-google-api-key

# Google AI Studio (separate key for AI Studio endpoint)
GOOGLE_STUDIO_KEY=your-google-studio-key

# DeepSeek (V3, R1)
DEEPSEEK_API_KEY=your-deepseek-key

# Alibaba Qwen (via DashScope)
QWEN_API_KEY=your-qwen-api-key

# === Local Model Settings ===
# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# === Evaluation Settings ===
# Model to use as the LLM-as-judge
JUDGE_MODEL=openai-gpt4o

# Model to use as the Consensus Engine judge
CONSENSUS_JUDGE=openai-gpt4o

# === Robotics Settings (optional) ===
# Pepper robot IP address
PEPPER_IP=192.168.1.100

# NAO robot IP address
NAO_IP=192.168.1.101

# Buddy robot WebSocket URL
BUDDY_WEBSOCKET_URL=ws://192.168.1.102:8765
